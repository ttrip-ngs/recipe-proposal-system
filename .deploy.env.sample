# scripts/deploy/*.sh の設定上書き用テンプレート.
# cp .deploy.env.sample .deploy.env して編集する (.deploy.env は git 管理外).
# 記載しなかった項目は scripts/deploy/config.sh の既定値が使われる.

# --- デプロイ先 --------------------------------------------------------------
# 表示名 recipe-system / プロジェクト番号 <GCP_PROJECT_NUMBER>
PROJECT_ID=<GCP_PROJECT_ID>
REGION=asia-northeast1
SERVICE_NAME=recipe-system

# --- LLM ---------------------------------------------------------------------
# Claude Sonnet 4.6 の Vertex クォータ承認が下りるまでは gemini を使う.
# 承認後は LLM_PROVIDER=claude に変更して deploy.sh を再実行する.
LLM_PROVIDER=gemini
# 空なら各クライアントの既定モデルを使う
LLM_MODEL=
# Claude / Gemini とも global エンドポイントで検証済み
VERTEX_AI_LOCATION=global
USD_JPY_RATE=155.0

# --- 予算アラート ------------------------------------------------------------
# 未指定なら gcloud billing projects describe から自動解決する
# BILLING_ACCOUNT_ID=XXXXXX-XXXXXX-XXXXXX
BUDGET_JPY=1500
