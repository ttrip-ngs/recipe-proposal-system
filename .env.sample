# =============================================================================
# .env.sample - 環境変数テンプレート
# このファイルをコピーして .env を作成する: cp .env.sample .env
# .env は git 管理対象外 (.gitignore 参照)
# =============================================================================

# -----------------------------------------------------------------------------
# Google Cloud 基本設定
# -----------------------------------------------------------------------------
# 使用する GCP プロジェクト ID (dev 環境想定)
GOOGLE_CLOUD_PROJECT=recipe-system-dev

# Vertex AI のリージョン (固定)
VERTEX_AI_LOCATION=asia-northeast1

# Vertex AI (Anthropic SDK) 用プロジェクト ID (通常は GOOGLE_CLOUD_PROJECT と同じ)
ANTHROPIC_VERTEX_PROJECT_ID=recipe-system-dev

# -----------------------------------------------------------------------------
# Firebase エミュレータ接続先 (ローカル開発用)
# 本番では未設定にする (これらが設定されているとエミュレータに接続する)
# -----------------------------------------------------------------------------
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ブラウザ側から見た Auth エミュレータ URL (Firebase Web SDK 用)
# Cloud Run ではなくローカル開発時のみ有効.
FIREBASE_AUTH_EMULATOR_HOST_BROWSER=http://localhost:9099

# Firebase Web SDK 初期化用 config (本番は Firebase Console の web app 設定をコピー)
# JSON 1 行で記述. 未設定時はログイン画面で開発者向けフォームのみ有効.
# FIREBASE_WEB_CONFIG_JSON={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}

# -----------------------------------------------------------------------------
# アプリ挙動制御
# -----------------------------------------------------------------------------
# Prompt Caching の有効化 (本番 true, ローカルは true / false どちらでも可)
USE_PROMPT_CACHE=true

# フェイク LLM モード (Vertex AI を呼ばずに固定レスポンスを返す)
# ローカル開発では true 推奨 (Vertex AI 課金なし)
# 非推奨 (後方互換用): 新規に切り替える場合は下記 LLM_PROVIDER を使うこと。
# LLM_PROVIDER 未指定時のみ、この値から fake/claude を導出する。
USE_FAKE_LLM=true

# LLM プロバイダの明示選択: fake / claude / gemini / anthropic
# 未指定なら上記 USE_FAKE_LLM から導出する (false なら claude)。
# gemini は Claude のクォータ未承認時などの代替経路、anthropic は Vertex の
# モデルアクセス未承認時に api.anthropic.com を直接利用する経路
# (詳細: docs/llm-integration.md §1.1)。
# LLM_PROVIDER=claude

# LLM_PROVIDER のデフォルトモデルを上書きしたい場合のみ指定 (例: gemini-2.5-pro)
# LLM_MODEL=gemini-2.5-pro

# 週間提案の詳細フェーズ (食材リストと手順) に使うモデルの上書き。
# 未指定なら骨子と同じモデルを使う (詳細: docs/llm-integration.md §3.1)。
# LLM_DETAIL_MODEL=claude-sonnet-5

# LLM_PROVIDER=anthropic のときのみ必須 (api.anthropic.com への直接アクセス用キー)
# ANTHROPIC_API_KEY=sk-ant-...

# 未知食材ポリシー: warn (提案を通す) / block (提案を止める)
UNKNOWN_INGREDIENT_POLICY=warn

# USD -> JPY 換算レート. BudgetGuardedClient が LLM トークン課金 (USD/1M) を
# JPY に換算する際に使う. 為替変動・運用判断で随時更新する.
USD_JPY_RATE=155.0

# 構造化ログレベル
LOG_LEVEL=INFO

# FastAPI セッション署名用シークレット
# 本番では Secret Manager から注入、ローカルは任意の文字列で可
SESSION_SECRET=dev-secret-change-me

# -----------------------------------------------------------------------------
# Cloud Run 固有 (本番のみ)
# -----------------------------------------------------------------------------
# Cloud Run が自動で設定する。ローカルでは未設定で uvicorn が 8000 を使う
# PORT=8080
